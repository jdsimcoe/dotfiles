.DS_Store

# Local machine-only shell overrides/secrets
.zshrc.local

# Zed runtime/user data (track only explicit config files copied into .config/zed)
.config/zed/conversations/
.config/zed/prompts/

# Karabiner runtime backups (track canonical config only)
.config/karabiner/automatic_backups/

# cliamp runtime state and authentication stay machine-local.
.config/cliamp/*credentials*
.config/cliamp/*token*
.config/cliamp/*cookie*
.config/cliamp/backups/
.config/cliamp/*.log
.config/cliamp/*.sock*
.config/cliamp/*.lock
.config/cliamp/history.toml
.config/cliamp/resume.json
.config/cliamp/plugins/.trust.json
.config/cliamp/themes/ANSIgray.toml
