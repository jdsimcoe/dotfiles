#!/usr/bin/env python3
"""Launch cliamp with grayscale colors resolved from the current terminal."""

import os
from pathlib import Path
import re
import select
import shutil
import sys
import tempfile
import termios
import time


REPLIES = re.compile(rb"\x1b\](10|11|4;(?:0|7|8|15));rgb:([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})(?:\x07|\x1b\\)")
QUERY_KEYS = ("10", "11", "4;0", "4;7", "4;8", "4;15")
SUBCOMMANDS = {
    "upgrade", "plugins", "playlist", "history", "setup", "spotify", "qobuz",
    "tidal", "play", "pause", "toggle", "next", "prev", "stop", "status",
    "volume", "seek", "load", "queue", "theme", "vis", "visstream", "shuffle",
    "repeat", "mono", "speed", "eq", "device", "remote", "open", "protocol", "help",
}


def config_directory():
    return Path(
        os.environ.get("CLIAMP_CONFIG_DIR")
        or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "cliamp"
    ).expanduser()


def parse_replies(data):
    colors = {}
    for match in REPLIES.finditer(data):
        components = [round(int(value, 16) * 255 / (16 ** len(value) - 1)) for value in match.groups()[1:]]
        colors[match[1].decode()] = "#" + "".join(f"{value:02x}" for value in components)
    return colors


def query_colors(fd, timeout=0.6):
    original = termios.tcgetattr(fd)
    settings = termios.tcgetattr(fd)
    settings[3] &= ~(termios.ECHO | termios.ICANON)
    settings[6][termios.VMIN] = 0
    settings[6][termios.VTIME] = 0
    data = b""
    colors = {}
    try:
        termios.tcsetattr(fd, termios.TCSANOW, settings)
        os.write(fd, "".join(f"\x1b]{key};?\x1b\\" for key in QUERY_KEYS).encode())
        deadline = time.monotonic() + timeout
        while len(colors) < len(QUERY_KEYS):
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
                break
            part = os.read(fd, 4096)
            if not part:
                break
            data += part
            colors = parse_replies(data)
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, original)
    return colors


def luminance(color):
    channels = [int(color[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    linear = [v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4 for v in channels]
    return sum(v * weight for v, weight in zip(linear, (0.2126, 0.7152, 0.0722)))


def theme_from_colors(colors):
    background = colors["11"]
    foreground = colors["10"]
    neutrals = list(dict.fromkeys([foreground] + [colors[f"4;{i}"] for i in (0, 7, 8, 15)]))
    bg_luma = luminance(background)

    def contrast(color):
        light = luminance(color)
        return (max(light, bg_luma) + 0.05) / (min(light, bg_luma) + 0.05)

    accent = max(neutrals, key=contrast)
    readable = [color for color in neutrals if contrast(color) >= 3]
    muted = min(readable, key=contrast) if readable else foreground
    return {
        "bg": background, "accent": accent, "bright_fg": foreground,
        "fg": muted, "green": foreground, "yellow": foreground, "red": accent,
    }


def write_theme(path, colors):
    content = "# Generated by script/amp from the terminal's grayscale palette.\n"
    content += "".join(f'{key} = "{value}"\n' for key, value in colors.items())
    if path.exists() and path.read_text() == content:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".ANSIgray-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(content)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def refresh_theme():
    path = config_directory() / "themes/ANSIgray.toml"
    colors = {}
    if sys.stdin.isatty() and sys.stdout.isatty():
        try:
            fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
            try:
                colors = query_colors(fd)
            finally:
                os.close(fd)
        except (OSError, termios.error):
            pass
    if all(key in colors for key in QUERY_KEYS):
        write_theme(path, theme_from_colors(colors))
        return True
    if not path.exists():
        # First-run fallback keeps the terminal background when OSC queries are unavailable.
        write_theme(path, {
            "accent": "#c0c0c0", "bright_fg": "#c0c0c0", "fg": "#808080",
            "green": "#c0c0c0", "yellow": "#c0c0c0", "red": "#e0e0e0",
        })
    return False


def main():
    args = sys.argv[1:]
    if args == ["--refresh-theme"]:
        refreshed = refresh_theme()
        print("Updated ANSIgray from terminal colors." if refreshed else "Kept cached/fallback ANSIgray colors (terminal queries unavailable).")
        return
    cliamp = shutil.which("cliamp")
    if not cliamp:
        raise SystemExit("cliamp is not installed or is not on PATH.")
    control = bool(args and args[0] in SUBCOMMANDS)
    if not control and not any(arg in ("--help", "-h", "--version", "-v", "--daemon", "-d") for arg in args):
        refresh_theme()
        if not any(arg == "--start-theme" or arg.startswith("--start-theme=") for arg in args):
            args = ["--start-theme", "ANSIgray", *args]
    os.execv(cliamp, [cliamp, *args])


if __name__ == "__main__":
    main()
