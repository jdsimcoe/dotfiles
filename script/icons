#!/usr/bin/env zsh

# icons — persistent custom-app-icon registry.
#
# Apps like Arc rewrite their Finder icon on launch (NSWorkspace.setIcon) and
# Sparkle updates replace the whole bundle. This keeps a registry of custom
# icons and a LaunchAgent that re-applies them.
#
#   icons add [app] [icon] [--bundle|--overlay]
#   icons list
#   icons rm <app>
#   icons apply [app...] [--force] [--quiet]
#   icons restore <app>
#   icons install | uninstall
#   icons doctor

set -euo pipefail

ICONS_HOME="${ICONS_HOME:-$HOME/.config/icons}"
APPS_DIR="${ICONS_APPS_DIR:-/Applications}"
USER_APPS_DIR="${ICONS_USER_APPS_DIR:-$HOME/Applications}"
REGISTRY="$ICONS_HOME/registry.tsv"
STORE_DIR="$ICONS_HOME/store"
BACKUP_DIR="$ICONS_HOME/backup"
STATE_DIR="$ICONS_HOME/state"
LOG_DIR="$ICONS_HOME/logs"
AGENT_LABEL="com.jdsimcoe.icons"
AGENT_PLIST="$HOME/Library/LaunchAgents/${AGENT_LABEL}.plist"
SCRIPT_PATH="${0:A}"

GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
NC="\033[0m"

step() { printf "${YELLOW}▶ %s${NC}\n" "$1"; }
ok() { printf "${GREEN}✔ %s${NC}\n" "$1"; }
warn() { printf "${YELLOW}! %s${NC}\n" "$1" >&2; }
die() { printf "${RED}✗ %s${NC}\n" "$1" >&2; exit 1; }

usage() {
  cat <<EOF
usage: icons <command> [args]

  add [app] [icon] [--bundle|--overlay]   register an icon (interactive if args missing)
  list                                  show the registry and applied state
  rm <app>                              remove entry, restore original icon
  apply [app...] [--force] [--quiet]    re-apply registry icons
  restore <app>                         restore the original icon, keep the entry
  install                               install/update the LaunchAgent
  uninstall                             remove the LaunchAgent (icons stay)
  doctor                                check fileicon, registry, agent, permissions

Registry: $REGISTRY
Modes: overlay = Finder custom icon locked with chflags uchg (safe)
       bundle  = replaces the .icns inside the bundle + ad-hoc re-sign
EOF
}

ensure_dirs() {
  mkdir -p "$STORE_DIR" "$BACKUP_DIR" "$STATE_DIR" "$LOG_DIR"
  [[ -f "$REGISTRY" ]] || : > "$REGISTRY"
}

sha() { shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1; }

app_name() { basename "$1" .app; }

# resolve_app <input> -> prints app path or fails
resolve_app() {
  local input="$1"
  [[ -z "$input" ]] && return 1
  local candidate
  if [[ "$input" == */* || "$input" == ~* ]]; then
    candidate="${input/#\~/$HOME}"
  else
    candidate="${input%.app}.app"
  fi
  if [[ -d "$candidate" ]]; then
    print -r -- "$candidate"
    return 0
  fi
  for dir in "$APPS_DIR" "$USER_APPS_DIR"; do
    if [[ -d "$dir/${candidate:t}" ]]; then
      print -r -- "$dir/${candidate:t}"
      return 0
    fi
  done
  return 1
}

# state helpers
state_file() { print -r -- "$STATE_DIR/$(app_name "$1").sha"; }
state_get() { local f; f="$(state_file "$1")"; [[ -f "$f" ]] && cat "$f"; }
state_set() { sha "$2" > "$(state_file "$1")"; }

# registry: path<TAB>mode<TAB>icon_basename
registry_entries() {
  [[ -f "$REGISTRY" ]] || return 0
  local line
  while IFS=$'\t' read -r line; do
    [[ -n "$line" ]] && print -r -- "$line"
  done < "$REGISTRY"
}

registry_find() { # prints "mode<TAB>icon" for app path $1
  local line
  while IFS=$'\t' read -r app mode icon; do
    if [[ "$app" == "$1" ]]; then
      print -r -- "$mode	$icon"
      return 0
    fi
  done < "$REGISTRY"
  return 1
}

registry_upsert() { # path mode icon
  local tmp="$REGISTRY.tmp.$$"
  if [[ -f "$REGISTRY" ]]; then
    grep -v -F "$1	" "$REGISTRY" > "$tmp" || true
  else
    : > "$tmp"
  fi
  print -r -- "$1	$2	$3" >> "$tmp"
  mv "$tmp" "$REGISTRY"
}

registry_remove() {
  local tmp="$REGISTRY.tmp.$$"
  grep -v -F "$1	" "$REGISTRY" > "$tmp" || true
  mv "$tmp" "$REGISTRY"
}

# copy or convert $2 into store as <AppName>.icns; prints store path
store_icon() {
  local name="$1" src="$2"
  local ext="${${src##*.}:l}"
  local out="$STORE_DIR/${name}.icns"
  case "$ext" in
    icns)
      cp "$src" "$out"
      ;;
    png|jpg|jpeg|tiff|tif)
      local tmp iconset
      tmp="$(mktemp -d "${TMPDIR:-/tmp}/icons.XXXXXX")"
      iconset="$tmp/${name}.iconset"
      mkdir -p "$iconset"
      local size
      for size in 16 32 128 256 512; do
        sips -z "$size" "$size" "$src" --out "$iconset/icon_${size}x${size}.png" >/dev/null
        sips -z "$(( size * 2 ))" "$(( size * 2 ))" "$src" \
          --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
      done
      iconutil -c icns -o "$out" "$iconset"
      rm -rf "$tmp"
      ;;
    *)
      rm -f "$out"
      die "unsupported icon format .$ext (use .icns, .png, .jpg, .jpeg, or .tiff; run .icon bundles through macos-icon first)"
      ;;
  esac
  print -r -- "$out"
}

# returns 0 = changed, 1 = unchanged/skipped
apply_overlay() {
  local app="$1" icns="$2"
  local res="$app/Icon"$'\r'
  local state="$(state_get "$app")"
  if [[ "$FORCE" != 1 && -e "$res" && -n "$state" && "$(sha "$res")" == "$state" ]]; then
    return 1
  fi
  chflags nouchg "$res" 2>/dev/null || true
  command -v fileicon >/dev/null 2>&1 || die "fileicon not found: brew install fileicon"
  if ! fileicon set "$app" "$icns"; then
    warn "could not write $app"
    warn "hint: run script/chowny \"$app\" (iru chowns apps back to root)"
    return 1
  fi
  # uchg makes the app's own NSWorkspace.setIcon rewrite fail.
  chflags uchg "$res" 2>/dev/null || true
  state_set "$app" "$res"
  return 0
}

# returns 0 = changed, 1 = unchanged/skipped
apply_bundle() {
  local app="$1" icns="$2"
  local plist="$app/Contents/Info.plist"
  local iconfile iconname target
  iconfile="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$plist" 2>/dev/null || true)"
  iconname="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconName' "$plist" 2>/dev/null || true)"
  if [[ -n "$iconfile" ]]; then
    target="$app/Contents/Resources/${iconfile%.icns}.icns"
  else
    target="$app/Contents/Resources/AppIcon.icns"
  fi
  local state="$(state_get "$app")"
  if [[ "$FORCE" != 1 && -f "$target" && -n "$state" && "$(sha "$target")" == "$state" ]]; then
    return 1
  fi
  local name bdir
  name="$(app_name "$app")"
  bdir="$BACKUP_DIR/$name"
  if [[ ! -d "$bdir" || -z "$(ls -A "$bdir" 2>/dev/null)" ]]; then
    mkdir -p "$bdir"
    [[ -f "$target" ]] && cp "$target" "$bdir/original.icns"
    cp "$plist" "$bdir/Info.plist"
  fi
  if ! cp "$icns" "$target"; then
    warn "could not write $target"
    warn "hint: run script/chowny \"$app\" (iru chowns apps back to root)"
    return 1
  fi
  if [[ -z "$iconfile" ]]; then
    /usr/libexec/PlistBuddy -c "Add :CFBundleIconFile string AppIcon" "$plist"
  fi
  # Assets.car would otherwise win over the .icns on disk.
  if [[ -n "$iconname" ]]; then
    /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$plist"
  fi
  codesign --force --deep --sign - "$app" >/dev/null 2>&1 || \
    warn "ad-hoc re-sign failed for $app"
  xattr -dr com.apple.quarantine "$app" 2>/dev/null || true
  state_set "$app" "$target"
  return 0
}

normalize_path() {
  local p="$1"
  p="${p#"${p%%[![:space:]]*}"}"   # ltrim
  p="${p%"${p##*[![:space:]]}"}"   # rtrim
  p="${p#\'}"; p="${p%\'}"
  p="${p#\"}"; p="${p%\"}"
  p="${p//\\ / }"                   # unescape '\ ' from drag/paste
  p="${p/#\~/$HOME}"
  print -r -- "$p"
}

pick_app() {
  local -a apps
  local d
  for d in "$APPS_DIR" "$USER_APPS_DIR"; do
    [[ -d "$d" ]] || continue
    apps+=("$d"/*.app(N:t))
  done
  (( ${#apps[@]} )) || die "no .app bundles found in $APPS_DIR"
  if command -v fzf >/dev/null 2>&1; then
    print -rl -- "${apps[@]}" | fzf --prompt 'App> '
  else
    local i
    for (( i = 1; i <= ${#apps[@]}; i++ )); do
      printf '%3d) %s\n' "$i" "${apps[$i]}"
    done
    local choice
    read -r "choice?App number: "
    print -r -- "${apps[$choice]}"
  fi
}

agent_installed() { [[ -f "$AGENT_PLIST" ]]; }

cmd_add() {
  local app_arg="" icon_arg="" mode=""
  while (( $# )); do
    case "$1" in
      --bundle) mode="bundle" ;;
      --overlay) mode="overlay" ;;
      *) if [[ -z "$app_arg" ]]; then app_arg="$1"; else icon_arg="$1"; fi ;;
    esac
    shift
  done

  local app
  if [[ -n "$app_arg" ]]; then
    app="$(resolve_app "$app_arg")" || die "app not found: $app_arg"
  else
    local pick
    pick="$(pick_app)" || die "no app selected"
    app="$(resolve_app "$pick")" || die "app not found: $pick"
  fi

  local icon="$icon_arg"
  if [[ -z "$icon" ]]; then
    read -r "icon?Icon path (drag/paste, .icns/.png): "
  fi
  icon="$(normalize_path "$icon")"
  [[ -f "$icon" ]] || die "icon not found: $icon"

  if [[ -z "$mode" ]]; then
    local m
    read -r "m?Mode [o]verlay (safe, Finder custom icon) / [b]undle (overwrite real bundle icon + ad-hoc re-sign, breaks Developer ID signature) [o]: "
    [[ "$m" == [bB]* ]] && mode="bundle" || mode="overlay"
  fi
  [[ "$mode" == "bundle" ]] && warn "bundle mode breaks the Developer ID signature; expect keychain/permission re-prompts"

  local name stored
  name="$(app_name "$app")"
  stored="$(store_icon "$name" "$icon")"
  registry_upsert "$app" "$mode" "${stored:t}"
  ok "registered $name ($mode) -> ${stored:t}"

  QUIET=0 FORCE=0
  apply_one "$app" || true
  refresh_caches
  agent_installed && cmd_install || true
}

apply_one() { # $1 = app path; updates CHANGED/SKIPPED
  local app="$1" entry mode icon
  entry="$(registry_find "$app")" || { warn "not in registry: $app"; return 1; }
  mode="${entry%%	*}"
  icon="${entry##*	}"
  local icns="$STORE_DIR/$icon"
  if [[ ! -d "$app" ]]; then
    warn "missing app: $app"
    return 1
  fi
  [[ -f "$icns" ]] || die "missing stored icon: $icns"
  local result=0
  if [[ "$mode" == "bundle" ]]; then
    apply_bundle "$app" "$icns" || result=$?
    (( result == 0 )) && BUNDLE_USED=1
  else
    apply_overlay "$app" "$icns" || result=$?
  fi
  if (( result == 0 )); then
    CHANGED=1
    (( QUIET )) || ok "applied ${icon%.icns} -> $(app_name "$app")"
  else
    (( QUIET )) || printf '  = %s (unchanged)\n' "$(app_name "$app")"
  fi
  return 0
}

refresh_caches() {
  (( CHANGED )) || return 0
  killall Dock 2>/dev/null || true
  if (( BUNDLE_USED )); then
    local app
    while IFS=$'\t' read -r app _ _; do
      [[ -d "$app" ]] && /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app" 2>/dev/null || true
    done < "$REGISTRY"
    killall Finder 2>/dev/null || true
  fi
}

cmd_apply() {
  local -a targets
  while (( $# )); do
    case "$1" in
      --force) FORCE=1 ;;
      --quiet) QUIET=1 ;;
      *) targets+=("$1") ;;
    esac
    shift
  done
  CHANGED=0 BUNDLE_USED=0
  if (( ${#targets[@]} )); then
    local t app
    for t in "${targets[@]}"; do
      app="$(resolve_app "$t")" || { warn "app not found: $t"; continue; }
      apply_one "$app" || true
    done
  else
    local app
    while IFS=$'\t' read -r app _ _; do
      [[ -n "$app" ]] && { apply_one "$app" || true; }
    done < "$REGISTRY"
  fi
  refresh_caches
}

cmd_restore() {
  local app
  app="$(resolve_app "$1")" || die "app not found: $1"
  local entry mode
  entry="$(registry_find "$app")" || die "not in registry: $app"
  mode="${entry%%	*}"
  if [[ "$mode" == "bundle" ]]; then
    local bdir="$BACKUP_DIR/$(app_name "$app")" plist="$app/Contents/Info.plist"
    if [[ -f "$bdir/original.icns" ]]; then
      local iconfile target
      iconfile="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$bdir/Info.plist" 2>/dev/null || true)"
      target="$app/Contents/Resources/${iconfile:-AppIcon}"
      target="${target%.icns}.icns"
      cp "$bdir/original.icns" "$target"
    fi
    [[ -f "$bdir/Info.plist" ]] && cp "$bdir/Info.plist" "$plist"
    codesign --force --deep --sign - "$app" >/dev/null 2>&1 || true
  else
    chflags nouchg "$app/Icon"$'\r' 2>/dev/null || true
    fileicon rm "$app" 2>/dev/null || warn "fileicon rm failed for $app"
  fi
  rm -f "$(state_file "$app")"
  killall Dock 2>/dev/null || true
  ok "restored $(app_name "$app")"
}

cmd_rm() {
  local input="$1" app="" rapp
  app="$(resolve_app "$input")" || app=""
  if [[ -z "$app" ]] || ! registry_find "$app" >/dev/null 2>&1; then
    # fall back to matching a registry entry by name or path
    app=""
    while IFS=$'\t' read -r rapp _ _; do
      if [[ "$rapp" == "$input" || "$(app_name "$rapp")" == "${input%.app}" ]]; then
        app="$rapp"
        break
      fi
    done < "$REGISTRY"
  fi
  [[ -n "$app" ]] || die "not in registry: $input"
  if [[ -d "$app" ]]; then
    cmd_restore "$app" || warn "restore failed; removing entry anyway"
  fi
  registry_remove "$app"
  rm -f "$STORE_DIR/$(app_name "$app").icns" "$(state_file "$app")"
  ok "removed $(app_name "$app")"
  agent_installed && cmd_install || true
}

cmd_list() {
  local found=0
  local app mode icon
  printf '%-24s %-8s %-28s %s\n' APP MODE ICON APPLIED
  while IFS=$'\t' read -r app mode icon; do
    [[ -z "$app" ]] && continue
    found=1
    local applied="?"
    if [[ ! -d "$app" ]]; then
      applied="missing app"
    elif [[ ! -f "$STORE_DIR/$icon" ]]; then
      applied="missing icon"
    else
      local cur="" state="$(state_get "$app")"
      if [[ "$mode" == "bundle" ]]; then
        local plist="$app/Contents/Info.plist" iconfile
        iconfile="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$plist" 2>/dev/null || true)"
        iconfile="${iconfile:-AppIcon}"
        cur="$(sha "$app/Contents/Resources/${iconfile%.icns}.icns")"
      else
        cur="$(sha "$app/Icon"$'\r')"
      fi
      if [[ -n "$state" && "$cur" == "$state" ]]; then applied="yes"; else applied="no"; fi
    fi
    printf '%-24s %-8s %-28s %s\n' "$(app_name "$app")" "$mode" "$icon" "$applied"
  done < "$REGISTRY"
  (( found )) || printf '(registry is empty — run: icons add)\n'
}

cmd_install() {
  mkdir -p "${AGENT_PLIST:h}"
  local -a watch=("$APPS_DIR" "$REGISTRY")
  local app
  while IFS=$'\t' read -r app _ _; do
    [[ -n "$app" ]] && watch+=("$app")
  done < "$REGISTRY"
  {
    cat <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jdsimcoe.icons</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
EOF
    printf '\t\t<string>%s</string>\n' "$SCRIPT_PATH"
    cat <<'EOF'
		<string>apply</string>
		<string>--quiet</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>WatchPaths</key>
	<array>
EOF
    local w
    for w in "${watch[@]}"; do
      printf '\t\t<string>%s</string>\n' "$w"
    done
    cat <<EOF
	</array>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>$LOG_DIR/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>$LOG_DIR/launchd.log</string>
</dict>
</plist>
EOF
  } > "$AGENT_PLIST"
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST"
  launchctl enable "gui/$(id -u)/$AGENT_LABEL"
  ok "LaunchAgent installed: $AGENT_PLIST"
}

cmd_uninstall() {
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  rm -f "$AGENT_PLIST"
  ok "LaunchAgent removed (icons left in place)"
}

cmd_doctor() {
  local problems=0
  if command -v fileicon >/dev/null 2>&1; then
    ok "fileicon: $(command -v fileicon)"
  else
    warn "fileicon missing — brew install fileicon"; (( problems++ ))
  fi
  local app mode icon
  while IFS=$'\t' read -r app mode icon; do
    [[ -z "$app" ]] && continue
    local name="$(app_name "$app")"
    if [[ -d "$app" ]]; then
      if [[ -w "$app" ]]; then
        ok "$name: present and writable"
      else
        warn "$name: not writable — run script/chowny \"$app\""; (( problems++ ))
      fi
    else
      warn "$name: app missing ($app)"; (( problems++ ))
    fi
    if [[ -f "$STORE_DIR/$icon" ]]; then
      ok "$name: stored icon $icon"
    else
      warn "$name: missing stored icon $icon"; (( problems++ ))
    fi
    local state="$(state_get "$app")"
    if [[ -n "$state" ]]; then
      ok "$name: applied sha ${state[1,12]}…"
    else
      warn "$name: no applied state (never applied or restored)"
    fi
  done < "$REGISTRY"
  if launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then
    ok "LaunchAgent loaded"
  else
    warn "LaunchAgent not loaded — run: icons install"; (( problems++ ))
  fi
  if (( problems == 0 )); then
    ok "all checks passed"
  else
    warn "$problems problem(s) found"
    return 1
  fi
}

main() {
  local cmd="${1:-help}"
  (( $# )) && shift

  case "$cmd" in
    help|-h|--help)
      usage
      return 0
      ;;
  esac

  if [[ "$(uname -s)" != "Darwin" ]]; then
    die "icons is for macOS only"
  fi

  ensure_dirs
  FORCE=0 QUIET=0 CHANGED=0 BUNDLE_USED=0

  case "$cmd" in
    add) cmd_add "$@" ;;
    list|ls) cmd_list "$@" ;;
    rm|remove) [[ $# -ge 1 ]] || die "usage: icons rm <app>"; cmd_rm "$@" ;;
    apply) cmd_apply "$@" ;;
    restore) [[ $# -ge 1 ]] || die "usage: icons restore <app>"; cmd_restore "$@" ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    doctor) cmd_doctor ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
