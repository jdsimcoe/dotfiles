#!/usr/bin/env bash

set -euo pipefail

# Prefer $BLUEUTIL, then PATH, then common Homebrew locations (ARM and Intel).
BLUEUTIL="${BLUEUTIL:-$(command -v blueutil || true)}"
if [[ -z "$BLUEUTIL" ]]; then
  for candidate in /opt/homebrew/bin/blueutil /usr/local/bin/blueutil; do
    if [[ -x "$candidate" ]]; then
      BLUEUTIL="$candidate"
      break
    fi
  done
fi
WAIT_SECONDS="${BT_RESET_WAIT_SECONDS:-2}"

if [[ "$(uname)" != "Darwin" ]]; then
  echo "bt-reset: macOS only" >&2
  exit 1
fi

if [[ -n "$BLUEUTIL" && -x "$BLUEUTIL" ]]; then
  echo "bt-reset: cycling Bluetooth power via blueutil"
  "$BLUEUTIL" --power 0
  sleep "$WAIT_SECONDS"
  "$BLUEUTIL" --power 1
  exit 0
fi

echo "bt-reset: blueutil not found, restarting bluetoothd"
if pkill -HUP bluetoothd 2>/dev/null; then
  echo "bt-reset: sent HUP to bluetoothd"
else
  killall bluetoothd 2>/dev/null || true
  echo "bt-reset: killed bluetoothd, launchd should respawn it"
fi
