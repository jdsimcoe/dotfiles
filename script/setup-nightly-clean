#!/usr/bin/env bash

# setup-nightly-clean — install the aggressive Friday maintenance job

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT_SRC="${SCRIPT_DIR}/nightly-clean"
PLIST_SRC="${SCRIPT_DIR}/com.jdsimcoe.nightly-clean.plist"
INSTALL_PATH="/usr/local/bin/nightly-clean"
PLIST_DEST="/Library/LaunchDaemons/com.jdsimcoe.nightly-clean.plist"
LOG_DIR="/Library/Logs/com.jdsimcoe.nightly-clean"
SERVICE="system/com.jdsimcoe.nightly-clean"

GREEN="\033[0;32m"
YELLOW="\033[1;33m"
NC="\033[0m"

step() { printf "${YELLOW}▶ %s${NC}\n" "$1"; }
ok() { printf "${GREEN}✔ %s${NC}\n" "$1"; }

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%s\n' "error This setup is for macOS only." >&2
  exit 1
fi

if [[ ! -x "${SCRIPT_SRC}" ]]; then
  printf 'error Maintenance script is not executable: %s\n' "${SCRIPT_SRC}" >&2
  exit 1
fi

/usr/bin/plutil -lint "${PLIST_SRC}" >/dev/null

step "Installing the maintenance script"
sudo mkdir -p "$(dirname "${INSTALL_PATH}")"
sudo ln -sfn "${SCRIPT_SRC}" "${INSTALL_PATH}"
sudo chmod 755 "${SCRIPT_SRC}"
ok "Installed ${INSTALL_PATH} -> ${SCRIPT_SRC}"

step "Installing and loading the system LaunchDaemon"
sudo install -d -o root -g wheel -m 755 "${LOG_DIR}"
sudo install -o root -g wheel -m 644 "${PLIST_SRC}" "${PLIST_DEST}"
sudo launchctl bootout "${SERVICE}" 2>/dev/null || true
sudo launchctl bootout system "${PLIST_DEST}" 2>/dev/null || true
sudo launchctl bootstrap system "${PLIST_DEST}"
sudo launchctl enable "${SERVICE}"
ok "Loaded ${SERVICE}"

step "Scheduling Friday wake"
# launchd runs at 23:59 Friday; wake two minutes earlier when the Mac is asleep.
# pmset supports one repeating power schedule, so this intentionally replaces it.
sudo pmset repeat cancel 2>/dev/null || true
sudo pmset repeat wakeorpoweron F 23:57:00
ok "The Mac will wake Friday at 23:57 and clean at 23:59."

step "Verifying installation"
printf '  Script: %s\n' "$(ls -la "${INSTALL_PATH}")"
printf '  Plist:  %s\n' "$(ls -la "${PLIST_DEST}")"
printf '  Job:    %s\n' "$(sudo launchctl print "${SERVICE}" | awk -F' = ' '/state =/ { print $2; exit }')"
printf '  Wake:   %s\n' "$(pmset -g sched | awk '/wakepoweron/ { print; exit }')"

printf '\n'
ok "Friday maintenance is installed."
printf '%s\n' "  • Aggressive cleanup runs every Friday at 23:59."
printf '%s\n' "  • A restart is scheduled only after 30+ minutes of console idle time."
printf '%s\n' "  • Logs: ${LOG_DIR}/weekly-clean-*.log"
printf '%s\n' "  • Preview: sudo ${INSTALL_PATH} --dry-run"
printf '%s\n' "  • Run now: sudo ${INSTALL_PATH}"
printf '%s\n' "  • Uninstall: sudo launchctl bootout ${SERVICE}"
printf '%s\n' "               sudo rm ${PLIST_DEST} ${INSTALL_PATH}"
printf '%s\n' "               sudo pmset repeat cancel"
