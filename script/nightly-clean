#!/usr/bin/env bash

# nightly-clean — aggressive unattended weekly macOS maintenance
#
# Runs as a root LaunchDaemon but points user-level tools at the target user's
# home. The launchd job is scheduled for Friday night by setup-nightly-clean.
# Use --dry-run to preview Mole and list the remaining maintenance steps.

set -euo pipefail

TARGET_USER="${TARGET_USER:-jdsimcoe}"
TARGET_GROUP="${TARGET_GROUP:-staff}"
TARGET_HOME="/Users/${TARGET_USER}"
REBOOT_AFTER_CLEAN="${REBOOT_AFTER_CLEAN:-1}"
MIN_IDLE_SECONDS_BEFORE_REBOOT="${MIN_IDLE_SECONDS_BEFORE_REBOOT:-1800}"
DRY_RUN=0

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
export HOME="${TARGET_HOME}"
export USER="${TARGET_USER}"
export LOGNAME="${TARGET_USER}"
export SUDO_USER="${TARGET_USER}"

LOG_DIR="/Library/Logs/com.jdsimcoe.nightly-clean"
LOG_FILE="${LOG_DIR}/weekly-clean-$(date +%Y%m%d-%H%M%S).log"
STARTED_AT="$(date +%s)"
INITIAL_AVAILABLE_KB="$(df -k / | awk 'NR == 2 { print $4 }')"

if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=1
elif [[ $# -gt 0 ]]; then
  printf 'Usage: %s [--dry-run]\n' "$0" >&2
  exit 2
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%s\n' "error This script is for macOS only." >&2
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  printf '%s\n' "error Run with sudo or install the LaunchDaemon first." >&2
  exit 1
fi

if [[ ! -d "${TARGET_HOME}" ]]; then
  printf '%s\n' "error Target home does not exist: ${TARGET_HOME}" >&2
  exit 1
fi

mkdir -p "${LOG_DIR}"
touch "${LOG_FILE}"
chmod 640 "${LOG_FILE}"
exec > >(/usr/bin/tee -a "${LOG_FILE}") 2>&1

step() { printf '\n▶ %s\n' "$1"; }
ok() { printf '✔ %s\n' "$1"; }
warn() { printf '⚠ %s\n' "$1"; }

finish() {
  local exit_code=$?
  local finished_at elapsed final_available_kb recovered_kb
  finished_at="$(date +%s)"
  elapsed=$((finished_at - STARTED_AT))
  final_available_kb="$(df -k / | awk 'NR == 2 { print $4 }')"
  recovered_kb=$((final_available_kb - INITIAL_AVAILABLE_KB))

  printf '\n=========================================\n'
  printf 'weekly-clean finished — %s\n' "$(date)"
  printf 'exit=%s duration=%ss recovered≈%sMB\n' \
    "${exit_code}" "${elapsed}" "$((recovered_kb / 1024))"
  printf 'log=%s\n' "${LOG_FILE}"
  printf '=========================================\n'

  chown "${TARGET_USER}:${TARGET_GROUP}" "${LOG_FILE}" 2>/dev/null || true
  exit "${exit_code}"
}
trap finish EXIT

run_as_target_user() {
  /usr/bin/sudo -u "${TARGET_USER}" /usr/bin/env \
    HOME="${TARGET_HOME}" \
    USER="${TARGET_USER}" \
    LOGNAME="${TARGET_USER}" \
    CI=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PATH="${PATH}" \
    "$@" </dev/null
}

is_corepack_shim() {
  local command_path="$1"
  local link_target

  [[ -L "${command_path}" ]] || return 1
  link_target="$(readlink "${command_path}" 2>/dev/null || true)"
  [[ "${link_target}" == *corepack* ]]
}

find_mole_bin() {
  local candidate
  for candidate in /opt/homebrew/bin/mo /usr/local/bin/mo; do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

repair_mole_state_ownership() {
  local path
  for path in \
    "${TARGET_HOME}/.cache/mole" \
    "${TARGET_HOME}/.config/mole" \
    "${TARGET_HOME}/Library/Logs/mole"; do
    if [[ -e "${path}" ]]; then
      chown -R "${TARGET_USER}:${TARGET_GROUP}" "${path}" 2>/dev/null || true
    fi
  done
}

run_mole_command() {
  local command_name="$1"
  local mole_bin="$2"
  local args=("${command_name}")
  local dry_run_suffix=""

  if [[ ${DRY_RUN} -eq 1 ]]; then
    args+=("--dry-run")
    dry_run_suffix=" --dry-run"
  fi

  printf '  • Mole: mo %s%s\n' "${command_name}" "${dry_run_suffix}"

  if env \
    HOME="${TARGET_HOME}" \
    USER="${TARGET_USER}" \
    LOGNAME="${TARGET_USER}" \
    SUDO_USER="${TARGET_USER}" \
    NO_COLOR=1 \
    TERM=dumb \
    "${mole_bin}" "${args[@]}"; then
    ok "Mole ${command_name} completed."
  else
    warn "Mole ${command_name} returned non-zero; continuing."
  fi

  repair_mole_state_ownership
}

console_idle_seconds() {
  local idle_ns
  idle_ns="$(ioreg -c IOHIDSystem -d 4 | awk '/HIDIdleTime/ { print $NF; exit }' | tr -d '"')"
  if [[ "${idle_ns}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$((idle_ns / 1000000000))"
  else
    printf '%s\n' "0"
  fi
}

printf '=========================================\n'
printf 'weekly-clean — %s\n' "$(date)"
printf 'mode=%s target=%s\n' "$([[ ${DRY_RUN} -eq 1 ]] && printf dry-run || printf live)" "${TARGET_USER}"
printf '=========================================\n'
df -h /

step "Running aggressive Mole cleanup and optimization"
if MOLE_BIN="$(find_mole_bin)"; then
  run_mole_command clean "${MOLE_BIN}"
  run_mole_command optimize "${MOLE_BIN}"
else
  warn "Mole CLI not found; install 'mo' to enable the main cleanup pass."
fi

step "Purging developer package-manager caches"
if [[ ${DRY_RUN} -eq 1 ]]; then
  printf '%s\n' "  • Would clean Homebrew, npm, Corepack, Yarn, and pnpm caches."
else
  if [[ -x /opt/homebrew/bin/brew || -x /usr/local/bin/brew ]]; then
    BREW_BIN="$(command -v brew)"
    run_as_target_user "${BREW_BIN}" cleanup -s || warn "Homebrew cleanup returned non-zero."
    run_as_target_user "${BREW_BIN}" autoremove || warn "Homebrew autoremove returned non-zero."
  fi

  if command -v npm >/dev/null 2>&1; then
    run_as_target_user "$(command -v npm)" cache clean --force || warn "npm cleanup returned non-zero."
  fi

  if command -v corepack >/dev/null 2>&1; then
    run_as_target_user "$(command -v corepack)" cache clean || warn "Corepack cleanup returned non-zero."
  fi

  if command -v yarn >/dev/null 2>&1; then
    YARN_BIN="$(command -v yarn)"
    if is_corepack_shim "${YARN_BIN}"; then
      warn "Yarn is a Corepack shim; skipped downloading Yarn just to clean its cache."
    else
      run_as_target_user "${YARN_BIN}" cache clean || warn "Yarn cleanup returned non-zero."
    fi
  fi

  if command -v pnpm >/dev/null 2>&1; then
    PNPM_BIN="$(command -v pnpm)"
    if is_corepack_shim "${PNPM_BIN}"; then
      warn "pnpm is a Corepack shim; skipped downloading pnpm just to prune its store."
    else
      run_as_target_user "${PNPM_BIN}" store prune || warn "pnpm cleanup returned non-zero."
    fi
  fi
fi
ok "Developer package-manager pass completed."

step "Pruning Xcode build data and stale developer support files"
DERIVED_DATA="${TARGET_HOME}/Library/Developer/Xcode/DerivedData"
MODULE_CACHE="${TARGET_HOME}/Library/Developer/Xcode/ModuleCache.noindex"
ARCHIVES="${TARGET_HOME}/Library/Developer/Xcode/Archives"
IOS_SUPPORT="${TARGET_HOME}/Library/Developer/Xcode/iOS DeviceSupport"
WATCHOS_SUPPORT="${TARGET_HOME}/Library/Developer/Xcode/watchOS DeviceSupport"

if [[ ${DRY_RUN} -eq 1 ]]; then
  printf '%s\n' "  • Would clear DerivedData and ModuleCache."
  printf '%s\n' "  • Would remove Archives and DeviceSupport older than 90 days."
else
  rm -rf "${DERIVED_DATA}" "${MODULE_CACHE}"
  find "${ARCHIVES}" "${IOS_SUPPORT}" "${WATCHOS_SUPPORT}" \
    -mindepth 1 -maxdepth 1 -type d -mtime +90 -print -exec rm -rf {} + \
    2>/dev/null || true

  if command -v xcrun >/dev/null 2>&1; then
    run_as_target_user "$(command -v xcrun)" simctl delete unavailable 2>/dev/null || true
  fi
fi
ok "Xcode maintenance completed."

step "Removing old crash reports and archived system logs"
if [[ ${DRY_RUN} -eq 1 ]]; then
  printf '%s\n' "  • Would remove diagnostic reports older than 30 days."
  printf '%s\n' "  • Would remove compressed /var/log archives older than 14 days."
else
  find "${TARGET_HOME}/Library/Logs/DiagnosticReports" \
    -type f -mtime +30 -print -delete 2>/dev/null || true
  find /Library/Logs/DiagnosticReports \
    -type f -mtime +30 -print -delete 2>/dev/null || true
  find /var/log -type f -name '*.gz' -mtime +14 -print -delete 2>/dev/null || true
fi
ok "Old reports and log archives pruned."

step "Running BSD periodic maintenance"
if [[ ${DRY_RUN} -eq 1 ]]; then
  printf '%s\n' "  • Would run periodic daily weekly monthly."
else
  periodic daily weekly monthly 2>/dev/null || true
fi
ok "Periodic maintenance completed."

step "Deleting local APFS snapshots"
SNAPSHOTS="$(tmutil listlocalsnapshotdates / 2>/dev/null | tail -n +2 || true)"
if [[ -z "${SNAPSHOTS}" ]]; then
  ok "No local snapshots found."
elif [[ ${DRY_RUN} -eq 1 ]]; then
  printf '%s\n' "${SNAPSHOTS}"
else
  while IFS= read -r snapshot; do
    [[ -n "${snapshot}" ]] || continue
    tmutil deletelocalsnapshots "${snapshot}" 2>/dev/null || true
  done <<<"${SNAPSHOTS}"
  ok "Local snapshots removed."
fi

step "Rotating weekly-clean logs"
if [[ ${DRY_RUN} -eq 0 ]]; then
  find "${LOG_DIR}" -type f -name 'weekly-clean-*.log' -mtime +60 -delete 2>/dev/null || true
fi
ok "Logs retained for 60 days."

if [[ ${DRY_RUN} -eq 1 ]]; then
  printf '\nDry run complete; no cleanup or restart was performed.\n'
  exit 0
fi

if [[ "${REBOOT_AFTER_CLEAN}" == "1" ]]; then
  IDLE_SECONDS="$(console_idle_seconds)"
  if (( IDLE_SECONDS >= MIN_IDLE_SECONDS_BEFORE_REBOOT )); then
    warn "Scheduling restart in one minute (console idle ${IDLE_SECONDS}s)."
    shutdown -r +1
  else
    warn "Skipping restart: console idle ${IDLE_SECONDS}s; need ${MIN_IDLE_SECONDS_BEFORE_REBOOT}s."
  fi
else
  ok "Restart disabled by REBOOT_AFTER_CLEAN=${REBOOT_AFTER_CLEAN}."
fi
