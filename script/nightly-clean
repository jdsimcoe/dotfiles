#!/usr/bin/env bash

# nightly-clean — Unattended weekly macOS maintenance
# Designed to run via launchd at midnight. No prompts.
# Resets Bluetooth, runs Mole cleanup/optimization, flushes DNS, prunes
# remaining targeted caches, and restarts the machine.
#
# Author: Jonathan Simcoe
# See also: script/clean (interactive, full version)

set -euo pipefail

# When running as a LaunchDaemon (root), HOME defaults to /var/root.
# Hardcode the target user's home so cache paths resolve correctly.
TARGET_USER="jdsimcoe"
TARGET_GROUP="staff"
export HOME="/Users/${TARGET_USER}"
export USER="${TARGET_USER}"
export LOGNAME="${TARGET_USER}"
export SUDO_USER="${TARGET_USER}"
export BLUEUTIL_ALLOW_ROOT=1
BT_RESET_SCRIPT="${HOME}/Developer/dotfiles/script/bt-reset"
PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
KANDJI_BIN="/usr/local/bin/kandji"
SOFTWAREUPDATE_BIN="/usr/sbin/softwareupdate"
MOLE_BIN=""

LOG="/tmp/nightly-clean-$(date +%Y%m%d).log"
exec > >(tee -a "$LOG") 2>&1

echo "========================================="
echo "nightly-clean — $(date)"
echo "========================================="

if [[ "$(uname)" != "Darwin" ]]; then
  echo "ERROR: This script is for macOS only."
  exit 1
fi

find_mole_bin() {
  local candidate
  for candidate in /opt/homebrew/bin/mo /usr/local/bin/mo; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  command -v mo 2>/dev/null || true
}

repair_mole_state_ownership() {
  local path
  for path in \
    "${HOME}/.cache/mole" \
    "${HOME}/.config/mole" \
    "${HOME}/Library/Logs/mole"; do
    if [[ -e "$path" ]]; then
      chown -R "${TARGET_USER}:${TARGET_GROUP}" "$path" 2>/dev/null || true
    fi
  done
}

run_mole_command() {
  local command_name="$1"
  shift || true

  if [[ -z "${MOLE_BIN}" ]]; then
    echo "⚠ Mole CLI not found; skipping mo ${command_name}."
    return 0
  fi

  echo "  • Mole: mo ${command_name} $*"
  if env \
    HOME="${HOME}" \
    USER="${TARGET_USER}" \
    LOGNAME="${TARGET_USER}" \
    SUDO_USER="${TARGET_USER}" \
    NO_COLOR=1 \
    TERM=dumb \
    "${MOLE_BIN}" "${command_name}" "$@"; then
    echo "  ✔ Mole ${command_name} completed."
  else
    echo "⚠ Mole ${command_name} returned non-zero; continuing anyway."
  fi

  repair_mole_state_ownership
}

MOLE_BIN="$(find_mole_bin)"

########################################
# 1) Bluetooth service reset
########################################
echo "▶ Resetting Bluetooth service..."
if [[ -x "${BT_RESET_SCRIPT}" ]]; then
  "${BT_RESET_SCRIPT}" || echo "⚠ bt-reset returned non-zero; continuing anyway."
  echo "✔ Bluetooth reset completed."
else
  echo "⚠ bt-reset script not found at ${BT_RESET_SCRIPT}; skipping Bluetooth reset."
fi

########################################
# 2) Flush DNS cache
########################################
echo "▶ Flushing DNS cache..."
dscacheutil -flushcache || true
killall -HUP mDNSResponder 2>/dev/null || true
echo "✔ DNS cache flushed."

########################################
# 3) Mole deep cleanup and optimization
#
# The launchd job runs as root, so Mole can perform sudo-gated portions without
# prompting. Keep HOME/USER pointed at the target account so user caches and
# Mole's operation log resolve to /Users/jdsimcoe, then repair ownership after.
########################################
echo "▶ Running Mole cleanup and optimization..."
run_mole_command clean
run_mole_command optimize
echo "✔ Mole pass completed."

########################################
# 4) System logs (truncate bloated logs, remove old archives)
########################################
echo "▶ Pruning system logs..."
find /var/log -type f -name "*.log" -size +50M -exec truncate -s 0 {} \; 2>/dev/null || true
find /var/log -type f -name "*.gz" -mtime +14 -delete 2>/dev/null || true
echo "✔ System logs pruned."

########################################
# 5) User-level cache pruning
#    (Skip browser caches — only prune general app caches)
########################################
echo "▶ Pruning user caches (excluding browsers)..."
USER_CACHE="${HOME}/Library/Caches"

# Prune old, large files from user caches — but skip browser directories
find "${USER_CACHE}" \
  -not -path "*/com.apple.Safari*" \
  -not -path "*/Dia*" \
  -not -path "*/Google/Chrome*" \
  -not -path "*/Firefox*" \
  -not -path "*/Arc*" \
  -not -path "*/BraveSoftware*" \
  -not -path "*/Microsoft Edge*" \
  -type f -mtime +14 -size +256k -delete 2>/dev/null || true
echo "✔ User caches pruned (browsers untouched)."

########################################
# 6) QuickLook cache
########################################
echo "▶ Clearing QuickLook cache..."
qlmanage -r cache 2>/dev/null || true
rm -rf "${HOME}/Library/Caches/com.apple.QuickLook.thumbnailcache" 2>/dev/null || true
rm -rf "${HOME}/Library/Caches/com.apple.QuickLookThumbnailsAgent" 2>/dev/null || true
echo "✔ QuickLook cache cleared."

########################################
# 7) Font caches
########################################
echo "▶ Clearing font caches..."
atsutil databases -remove 2>/dev/null || true
echo "✔ Font caches cleared."

########################################
# 8) Crash reports older than 30 days
########################################
echo "▶ Removing old crash reports..."
find "${HOME}/Library/Logs/DiagnosticReports" -type f -mtime +30 -delete 2>/dev/null || true
find /Library/Logs/DiagnosticReports -type f -mtime +30 -delete 2>/dev/null || true
echo "✔ Old crash reports removed."

########################################
# 9) Container cache pruning
########################################
echo "▶ Pruning container caches..."
CONTAINERS_DIR="${HOME}/Library/Containers"
find "${CONTAINERS_DIR}" -path "*/Data/Library/Caches/*" -type f -mtime +14 -size +256k -delete 2>/dev/null || true
find "${CONTAINERS_DIR}" -path "*/Data/Library/Logs/*" -type f -mtime +30 -size +1M -delete 2>/dev/null || true
echo "✔ Container caches pruned."

########################################
# 10) BSD periodic maintenance
########################################
echo "▶ Running periodic maintenance scripts..."
periodic daily weekly monthly 2>/dev/null || true
echo "✔ Periodic maintenance completed."

########################################
# 11) Purge inactive memory
########################################
echo "▶ Purging inactive memory..."
purge 2>/dev/null || true
echo "✔ Memory purged."

########################################
# 12) Flush APFS snapshot metadata
########################################
echo "▶ Cleaning stale APFS snapshots..."
SNAPSHOTS=$(tmutil listlocalsnapshotdates / 2>/dev/null | tail -n +2 || true)
if [[ -n "$SNAPSHOTS" ]]; then
  SNAP_COUNT=0
  echo "$SNAPSHOTS" | while read -r snap; do
    [[ -n "$snap" ]] && tmutil deletelocalsnapshots "$snap" 2>/dev/null || true
    ((SNAP_COUNT++)) || true
  done
  echo "✔ Local Time Machine snapshots removed."
else
  echo "✔ No stale snapshots found."
fi

########################################
# 13) Rotate old nightly-clean logs
########################################
echo "▶ Rotating old nightly-clean logs..."
find /tmp -name "nightly-clean-*.log" -mtime +7 -delete 2>/dev/null || true
echo "✔ Old logs removed (keeping last 7 days)."

########################################
# 14) Flush kernel/network caches
########################################
echo "▶ Resetting network service order and flushing routes..."
route -n flush 2>/dev/null || true
echo "✔ Routing table flushed."

########################################
# 15) Managed app + macOS updates
########################################
echo "▶ Running Kandji and macOS updates..."
set +e

if [[ -x "${KANDJI_BIN}" ]]; then
  echo "  • Kandji: refreshing MDM state..."
  "${KANDJI_BIN}" update-mdm || echo "⚠ Kandji update-mdm returned non-zero."

  echo "  • Kandji: checking library items..."
  "${KANDJI_BIN}" library || echo "⚠ Kandji library returned non-zero."

  echo "  • Kandji: refreshing installed app inventory..."
  "${KANDJI_BIN}" collect-apps || echo "⚠ Kandji collect-apps returned non-zero."
else
  echo "⚠ Kandji CLI not found at ${KANDJI_BIN}; skipping Kandji update pass."
fi

if [[ -x "${SOFTWAREUPDATE_BIN}" ]]; then
  echo "  • macOS: forcing update scan..."
  "${SOFTWAREUPDATE_BIN}" --background --force || echo "⚠ softwareupdate background scan returned non-zero."

  echo "  • macOS: listing available updates..."
  AVAILABLE_UPDATES="$("${SOFTWAREUPDATE_BIN}" --list 2>&1 || true)"
  echo "${AVAILABLE_UPDATES}"

  if echo "${AVAILABLE_UPDATES}" | grep -Eq '^\s*\*'; then
    echo "  • macOS: installing all available updates..."
    "${SOFTWAREUPDATE_BIN}" --install --all --agree-to-license || \
      echo "⚠ softwareupdate install returned non-zero (owner auth may be required on Apple Silicon)."
  else
    echo "  • macOS: no available updates."
  fi
else
  echo "⚠ softwareupdate binary not found at ${SOFTWAREUPDATE_BIN}; skipping Apple updates."
fi

set -e
echo "✔ Managed update pass completed."

########################################
# Done — restart
########################################
echo ""
echo "========================================="
echo "nightly-clean complete — $(date)"
echo "Restarting in 10 seconds..."
echo "========================================="

sleep 10
shutdown -r now
