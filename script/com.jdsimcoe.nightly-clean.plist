<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jdsimcoe.nightly-clean</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/nightly-clean</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MIN_IDLE_SECONDS_BEFORE_REBOOT</key>
        <string>1800</string>
        <key>REBOOT_AFTER_CLEAN</key>
        <string>1</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>59</integer>
    </dict>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Library/Logs/com.jdsimcoe.nightly-clean/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/com.jdsimcoe.nightly-clean/launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
