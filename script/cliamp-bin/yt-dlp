#!/usr/bin/env python3
"""Filter YouTube titles only for yt-dlp processes launched through amp."""

import os
from pathlib import Path
import re
import shutil
import sys
from urllib.parse import urlsplit


def is_youtube(value):
    if re.match(r"ytsearch(?:date)?\d*:", value):
        return True
    try:
        host = urlsplit(value).hostname or ""
    except ValueError:
        return False
    return host == "youtu.be" or host == "youtube.com" or host.endswith(".youtube.com")


def main():
    shim = Path(__file__).resolve()
    search_path = os.pathsep.join(
        part for part in os.environ.get("PATH", "").split(os.pathsep)
        if Path(part).resolve() != shim.parent
    )
    executable = os.environ.get("CLIAMP_YTDLP") or shutil.which("yt-dlp", path=search_path)
    if not executable or Path(executable).resolve() == shim:
        raise SystemExit("yt-dlp is not installed or is not on PATH.")
    args = sys.argv[1:]
    metadata = any(arg in ("-j", "--dump-json", "-J", "--dump-single-json") for arg in args)
    if metadata and any(is_youtube(arg) for arg in args):
        config = shim.parents[2] / ".config/cliamp/yt-dlp-title-filter.conf"
        args = ["--config-locations", str(config), *args]
    os.execv(executable, [executable, *args])


if __name__ == "__main__":
    main()
