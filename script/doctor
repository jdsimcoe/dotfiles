#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATUS=0

check_link() {
  local source="$1"
  local target="$2"

  if [[ -L "$target" ]]; then
    local current
    current="$(readlink "$target")"
    if [[ "$current" == "$source" ]]; then
      printf 'ok    %s -> %s\n' "$target" "$source"
      return
    fi

    printf 'mismatch %s -> %s (expected %s)\n' "$target" "$current" "$source"
    STATUS=1
    return
  fi

  if [[ -e "$target" ]]; then
    printf 'copy  %s exists but is not symlinked to %s\n' "$target" "$source"
    STATUS=1
    return
  fi

  printf 'miss  %s is missing (expected link to %s)\n' "$target" "$source"
  STATUS=1
}

check_link "$REPO_ROOT/.hushlogin" "$HOME/.hushlogin"
check_link "$REPO_ROOT/.zprofile" "$HOME/.zprofile"
check_link "$REPO_ROOT/.zshrc" "$HOME/.zshrc"
check_link "$REPO_ROOT/.config/starship.toml" "$HOME/.config/starship.toml"
check_link "$REPO_ROOT/.config/nvim" "$HOME/.config/nvim"
check_link "$REPO_ROOT/.config/ghostty/config" "$HOME/Library/Application Support/com.mitchellh.ghostty/config"
check_link "$REPO_ROOT/.config/ghostty/themes" "$HOME/.config/ghostty/themes"
check_link "$REPO_ROOT/.config/karabiner/karabiner.json" "$HOME/.config/karabiner/karabiner.json"
check_link "$REPO_ROOT/.config/karabiner/assets/complex_modifications" "$HOME/.config/karabiner/assets/complex_modifications"
check_link "$REPO_ROOT/.config/zed/settings.json" "$HOME/.config/zed/settings.json"

for font in "$REPO_ROOT"/fonts/pragma/*.ttf; do
  target="$HOME/Library/Fonts/$(basename "$font")"
  if [[ -f "$target" ]] && cmp -s "$font" "$target"; then
    printf 'ok    %s (copy of repo font)\n' "$target"
  else
    printf 'miss  %s (run script/setup)\n' "$target"
    STATUS=1
  fi
done

CLIAMP_DIR="${CLIAMP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cliamp}"
for plugin in "$REPO_ROOT"/.config/cliamp/plugins/*.lua; do
  [[ "$(basename "$plugin")" == "mandelbrot-atom.lua" ]] && continue
  check_link "$plugin" "$CLIAMP_DIR/plugins/$(basename "$plugin")"
done
for config in config.toml themes/ANSIgray.toml; do
  if [[ -f "$CLIAMP_DIR/$config" ]]; then
    printf 'ok    %s (machine-local)\n' "$CLIAMP_DIR/$config"
  else
    printf 'miss  %s (run script/setup-cliamp)\n' "$CLIAMP_DIR/$config"
    STATUS=1
  fi
done

exit "$STATUS"
