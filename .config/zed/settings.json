{
  "agent_buffer_font_size": 15.5,
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": ""
    }
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://github\\.com"
            }
          ]
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "write_paths": [
        {
          "requested": "/Users/jdsimcoe/Library/Caches/Homebrew",
          "resolved": "/Users/jdsimcoe/Library/Caches/Homebrew"
        },
        {
          "requested": "/usr/local",
          "resolved": "/usr/local"
        },
        {
          "requested": "/Users/jdsimcoe/.homebrew",
          "resolved": "/Users/jdsimcoe/.homebrew"
        },
        {
          "requested": "/Users/jdsimcoe/.config/cliamp",
          "resolved": "/Users/jdsimcoe/.config/cliamp"
        }
      ],
      "network_hosts": [
        "formulae.brew.sh",
        "github.com",
        "*.githubusercontent.com",
        "api.github.com"
      ]
    },
    "default_model": {
      "provider": "vercel_ai_gateway",
      "model": "anthropic/claude-fable-5",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "buffer_font_family": "Berkeley Mono",
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "telemetry": {
    "anthropic_retention": true,
    "diagnostics": false,
    "metrics": false
  },
  "tab_size": 2,
  "tab_bar": {
    "show": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15.5,
  "soft_wrap": "editor_width",
  "theme": {
    "mode": "light",
    "light": "Atom Dark",
    "dark": "Atom Dark"
  },
  // Extensions installed automatically on launch. "Atom Dark" is not an
  // extension: it ships as .config/zed/themes/atom.json (source: jdsimcoe/atom-zed),
  // symlinked to ~/.config/zed/themes by script/setup.
  "auto_install_extensions": {
    "html": true,
    "zed-legacy-themes": true
  },
  "language_models": {
    "vercel_ai_gateway": {
      "api_url": "https://ai-gateway.vercel.sh/coding-agent/v1",
      "available_models": [
        {
          "name": "anthropic/claude-fable-5",
          "display_name": "Claude Fable 5",
          "max_tokens": 1000000,
          "max_output_tokens": 128000,
          "capabilities": {
            "tools": true,
            "images": true
          }
        }
      ]
    }
  }
}
