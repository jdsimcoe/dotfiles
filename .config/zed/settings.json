{
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": ""
    }
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "write_paths": [
        {
          "requested": "/Users/jdsimcoe/Library/Caches/Homebrew",
          "resolved": "/Users/jdsimcoe/Library/Caches/Homebrew"
        },
        {
          "requested": "/usr/local",
          "resolved": "/usr/local"
        },
        {
          "requested": "/Users/jdsimcoe/.homebrew",
          "resolved": "/Users/jdsimcoe/.homebrew"
        },
        {
          "requested": "/Users/jdsimcoe/.config/cliamp",
          "resolved": "/Users/jdsimcoe/.config/cliamp"
        }
      ],
      "network_hosts": [
        "formulae.brew.sh",
        "github.com",
        "*.githubusercontent.com",
        "api.github.com"
      ]
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-fable-5",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_font_family": "Monaspace Xenon",
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "telemetry": {
    "anthropic_retention": true,
    "diagnostics": false,
    "metrics": false,
  },
  "tab_size": 2,
  "tab_bar": {
    "show": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "soft_wrap": "editor_width",
  "theme": {
    "mode": "light",
    "light": "Atom Dark",
    "dark": "Atom Dark",
  },
  // Extensions installed automatically on launch. "Atom Dark" is not an
  // extension: it ships as .config/zed/themes/atom.json (source: jdsimcoe/atom-zed),
  // symlinked to ~/.config/zed/themes by script/setup.
  "auto_install_extensions": {
    "html": true,
    "zed-legacy-themes": true,
  },
}
