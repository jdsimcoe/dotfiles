{
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.5-pro",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_font_family": "Monaspace Xenon",
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tab_size": 2,
  "tab_bar": {
    "show": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "soft_wrap": "editor_width",
  "theme": {
    "mode": "dark",
    "light": "Zed Legacy: Atelier Cave Light",
    "dark": "Flexoki Dark",
  },
}
