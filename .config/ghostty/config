# Ghostty
auto-update-channel = stable
theme = vercel-dark.ghostty
window-colorspace = display-p3

# Font
# GeistMono Nerd Font (brew.sh: font-geist-mono-nerd-font), per vercel.com/geist/terminal
font-family = "GeistMono Nerd Font Mono"
font-size = 14

# Paper Mono (disabled; uncomment to restore)
# font-family = "Paper Mono"
# font-feature = ss03
# font-size = 16
# adjust-cell-height = 4
# adjust-cell-width = -5%
# font-variation = wght=400
# font-variation-bold = wght=700
# font-variation-italic = wght=400
# font-variation-bold-italic = wght=700

# Window
macos-titlebar-style = tabs
window-save-state = always
window-step-resize = false

window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# Input
keybind = shift+enter=text:\n
